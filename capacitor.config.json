{
  "appId": "com.chaiproductions.breslovpro",
  "appName": "Breslov Pro",
  "webDir": "www",
  "android": {
    "backgroundColor": "#020E29"
  },
  "ios": {
    "backgroundColor": "#020E29",
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#020E29",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "LocalNotifications": {
      "iconColor": "#E8A33D"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}